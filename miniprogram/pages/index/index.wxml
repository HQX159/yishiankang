<!-- pages/index/index.wxml -->
<view class="container">
  <view class="page-title">健康仪表盘</view>
  <view class="page-subtitle">欢迎回来，这里是您的控糖饮食概览</view>

  <view class="stats-grid">
    <view class="stat-card" bindtap="goRecipes">
      <view class="stat-icon">📋</view>
      <view class="stat-value">{{recipeCount}}</view>
      <view class="stat-label">生成食谱</view>
    </view>
    <view class="stat-card" bindtap="goFavorites">
      <view class="stat-icon">⭐</view>
      <view class="stat-value">{{favoriteCount}}</view>
      <view class="stat-label">收藏食谱</view>
    </view>
    <view class="stat-card" bindtap="goUploadHealth">
      <view class="stat-icon">📄</view>
      <view class="stat-value">{{reportCount}}</view>
      <view class="stat-label">健康报告</view>
    </view>
    <view class="stat-card" bindtap="goUploadFridge">
      <view class="stat-icon">🥕</view>
      <view class="stat-value">{{ingredientCount}}</view>
      <view class="stat-label">识别食材</view>
    </view>
  </view>

  <view class="quick-actions">
    <button class="btn btn-outline" bindtap="goFoodGuide">🍎 食品科普 · 零食水果怎么吃</button>
    <button class="btn btn-outline" bindtap="goUploadHealth">上传健康报告</button>
    <button class="btn btn-outline" bindtap="goUploadFridge">拍照识别食材</button>
    <button class="btn btn-primary" bindtap="goGenerate">AI 生成食谱</button>
  </view>

  <view wx:if="{{hasHealth}}" class="info-card">
    <view class="info-card-title">最新健康报告</view>
    <view class="info-text">{{healthContent}}</view>
    <view style="color:#9ca3af;font-size:24rpx;margin-top:12rpx;">上传于 {{healthDate}}</view>
  </view>
  <view wx:else class="info-card">
    <view class="info-card-title">最新健康报告</view>
    <view style="color:#9ca3af;">暂无健康报告，请上传</view>
  </view>

  <view class="info-card">
    <view class="info-card-title">冰箱现有食材</view>
    <view wx:if="{{hasIngredients}}" class="ingredient-tags">
      <view class="ingredient-tag" wx:for="{{latestIngredients}}" wx:key="name">
        {{item.displayName}}
      </view>
    </view>
    <view wx:else style="color:#9ca3af;">暂无食材数据，请拍照上传</view>
  </view>

  <view style="margin-top:28rpx;">
    <view style="font-size:32rpx;font-weight:600;color:#1f2937;margin-bottom:24rpx;">最近生成的食谱</view>
    <view wx:if="{{hasRecipes}}">
      <view class="recipe-item" wx:for="{{recentRecipes}}" wx:key="id"
            bindtap="goRecipeDetail" data-id="{{item.id}}">
        <view class="recipe-item-title">{{item.title}}</view>
        <view class="recipe-item-meta">{{item.created_at}}</view>
      </view>
      <button class="btn btn-outline btn-block" style="margin-top:20rpx;" bindtap="goRecipes">查看全部</button>
    </view>
    <view wx:else class="empty-state" style="padding:60rpx;">
      <view class="empty-icon">🍳</view>
      <view class="empty-desc">还没有生成过食谱</view>
    </view>
  </view>
</view>
