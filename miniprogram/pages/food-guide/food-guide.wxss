.food-guide { color:#1f2937; font-size:30rpx; line-height:1.8; }
.intro { border-left:8rpx solid #16a34a; padding-left:24rpx; margin:20rpx 0 36rpx; }
.eyebrow,.portion { color:#166534; font-weight:600; }
.search-panel,.portion-panel,.food-card { padding:28rpx; border:2rpx solid #e5e7eb; background:#fff; border-radius:20rpx; margin:24rpx 0; }
.search-panel { background:#f0fdf4; border-color:#bbf7d0; }
.portion-panel { border-color:#16a34a; }
.food-guide input { border:2rpx solid #9ca3af; background:white; padding:20rpx; border-radius:12rpx; margin:16rpx 0; height:56rpx; font-size:30rpx; }
.food-guide button { margin-top:20rpx; font-size:30rpx; white-space:normal; }
.filters { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:20rpx; }
.picker { padding:16rpx; background:white; border:2rpx solid #9ca3af; border-radius:12rpx; }
.section-title { font-weight:700; font-size:34rpx; margin-top:28rpx; }
.food-name { font-size:34rpx; font-weight:600; margin:14rpx 0; }
.card-top { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12rpx; }
.badge { display:inline-block; padding:4rpx 14rpx; border-radius:10rpx; font-size:28rpx; font-weight:600; }
.recommend { color:#166534; background:#dcfce7; }.limit { color:#854d0e; background:#fef9c3; }.occasional { color:#9a3412; background:#ffedd5; }
.reference { color:#374151; background:#f3f4f6; }
.muted,.footnote { color:#4b5563; }.muted { margin:10rpx 0; }
.footnote,.empty { padding:28rpx 0; }.error { color:#991b1b; padding:20rpx; background:#fef2f2; margin:16rpx 0; }
.result-value { font-weight:700; color:#166534; font-size:34rpx; margin:22rpx 0; }
.craving-panel { background:#fff7ed; border-left:6rpx solid #9a3412; padding:20rpx; margin:20rpx 0; }
.source-btn { text-align:left; color:#166534; background:#f0fdf4; font-size:26rpx !important; }
